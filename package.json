{
  "name": "ai-review-gate",
  "version": "0.1.0",
  "description": "A compiler-like quality gate for AI-generated code. Same policy in Claude Code sessions and on GitHub PRs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "aigate": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "policy.yml",
    "semgrep/rules.yml",
    "hooks"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "aigate": "node dist/src/cli.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demartinogiuseppe/ai-review-gate.git"
  },
  "homepage": "https://github.com/demartinogiuseppe/ai-review-gate#readme",
  "bugs": {
    "url": "https://github.com/demartinogiuseppe/ai-review-gate/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "claude-code",
    "code-review",
    "quality-gate",
    "static-analysis",
    "semgrep",
    "git-hooks",
    "github-actions",
    "linter"
  ]
}

{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./node_modules/ai-review-gate/hooks/aigate-hook.mjs",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ./node_modules/ai-review-gate/hooks/aigate-hook.mjs",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
